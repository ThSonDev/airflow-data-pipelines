# Copy the lines you need into airflow/.env (keep the existing AIRFLOW_* lines; do not overwrite the file).
# Docker compose passes STREAM_RUN_SECONDS, SIMULATE_CRASH_BATCH and the secrets below into the containers.
# Other absa_core.get_settings() variables (POSTGRES_*, KAFKA_*, ...) are not passed: the container
# defaults match the Docker setup. Export them in your shell to run the ABSA scripts on the host (.venv).
#
# Already in airflow/.env for docker compose (example values, keep your own):
# AIRFLOW_UID=1000
# AIRFLOW_GID=0
# AIRFLOW_PROJ_DIR=.

# Run length in seconds for producer and consumer (default 2700); 600 gives a short test run
STREAM_RUN_SECONDS=600
# Crash once at this batch id (default -1 = off); delete airflow/checkpoints/absa_streaming to crash again
SIMULATE_CRASH_BATCH=-1

# Airflow 3 secrets. Local-dev defaults are built into docker-compose.yaml; set your own values here to override.
# Never put a real or shared secret in this example file. The JWT secret must be the same for all Airflow services.
# AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-long-random-string
# Fernet key encrypts connection passwords; empty = no encryption (fine for local dev)
# FERNET_KEY=
