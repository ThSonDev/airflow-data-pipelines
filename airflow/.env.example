# Optional: add these to airflow/.env (keep the existing AIRFLOW_* lines; do not overwrite the file).
# Defaults in absa_core.get_settings() match the Docker setup, so set these only to override
# them, for example to run the ABSA scripts on the host (.venv) instead of in the container.
#
# Already in airflow/.env for docker compose (example values, keep your own):
# AIRFLOW_UID=1000
# AIRFLOW_GID=0
# AIRFLOW_PROJ_DIR=.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=absa-reviews
MODELS_DIR=/opt/airflow/models
DATA_DIR=/opt/airflow/projects/absa_streaming/data
TMP_DIR=/opt/airflow/models/tmp
